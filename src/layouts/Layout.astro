---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Cookie Challenge — Abre una galleta al día y descubre tu reto diario." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Cookie Challenge</title>
  </head>
  <body class="bg-layer text-layer font-retro antialiased selection:bg-retro-highlight selection:text-ui-bg relative min-h-screen overflow-x-hidden">
    <!-- Starry Background -->
    <div id="stars-container" class="absolute inset-0 pointer-events-none z-[-1]"></div>
    <!-- Main Content -->
    <slot />
    <!-- CRT Screen Effect Overlay -->
    <div class="crt-overlay pointer-events-none fixed inset-0 z-50"></div>
    
    <script>
      // Generate random pixel stars in the background
      const starsContainer = document.getElementById('stars-container');
      if (starsContainer) {
        for (let i = 0; i < 50; i++) {
          const star = document.createElement('div');
          star.className = 'pixel-star';
          star.style.left = `${Math.random() * 100}%`;
          star.style.top = `${Math.random() * 100}%`;
          star.style.animationDelay = `${Math.random() * 2}s`;
          starsContainer.appendChild(star);
        }
      }
    </script>
  </body>
</html>