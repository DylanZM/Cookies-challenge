---
import '../styles/streak.css';
---

<div id="streak-display" class="streak-container pixel-box">
  <div class="streak-icon">
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
      <path d="M13 16h2v4h2v2H7v-2h2v-4h2v-2h2v2Zm-6 4H5v-2h2v2Zm12 0h-2v-2h2v2ZM5 18H3v-8h2v8Zm16 0h-2v-6h2v6Zm-6-6h-2v-2h2v2Zm4 0h-2v-2h2v2ZM7 10H5V8h2v2Zm6 0h-2V6h2v4Zm4 0h-2V8h2v2ZM9 8H7V6h2v2Zm2-2H9V2h2v4Z"/>
    </svg>
  </div>
  <div class="streak-content">
    <div class="streak-number" id="streak-number">0</div>
    <div class="streak-label">DAY STREAK</div>
  </div>
  <div id="streak-badge" class="streak-badge"></div>
</div>

<script>
  interface StreakData {
    count: number;
    lastDate: string;
  }

  function getStreak(): StreakData {
    const stored = localStorage.getItem("cookie_streak");
    if (!stored) return { count: 0, lastDate: "" };
    try {
      return JSON.parse(stored);
    } catch {
      return { count: 0, lastDate: "" };
    }
  }

  function saveStreak(data: StreakData) {
    localStorage.setItem("cookie_streak", JSON.stringify(data));
  }

  function getToday(): string {
    return new Date().toISOString().split("T")[0];
  }

  function getYesterday(): string {
    const d = new Date();
    d.setDate(d.getDate() - 1);
    return d.toISOString().split("T")[0];
  }

  function updateStreakCounter(newStreak: boolean = false) {
    const streak = getStreak();
    const numberEl = document.getElementById("streak-number");
    const badgeEl = document.getElementById("streak-badge");

    if (numberEl) {
      numberEl.textContent = streak.count.toString();

      if (newStreak) {
        numberEl.classList.add("streak-increase");
        setTimeout(() => numberEl.classList.remove("streak-increase"), 600);
        createConfetti();
      }
    }

    if (badgeEl) {
      if (streak.count >= 30) badgeEl.textContent = "👑";
      else if (streak.count >= 14) badgeEl.textContent = "💎";
      else if (streak.count >= 7) badgeEl.textContent = "⭐";
      else if (streak.count >= 3) badgeEl.textContent = "✨";
      else badgeEl.textContent = "";
    }
  }

  function createConfetti() {
    const container = document.getElementById("streak-display");
    if (!container) return;

    const colors = ["#ffb84d", "#d28c46", "#e6ab67", "#ff6b6b", "#4ecdc4"];

    for (let i = 0; i < 12; i++) {
      const particle = document.createElement("div");
      particle.className = "confetti-particle";
      particle.style.background = colors[Math.floor(Math.random() * colors.length)];

      const angle = (Math.PI * 2 * i) / 12;
      const distance = 60 + Math.random() * 40;
      const tx = Math.cos(angle) * distance;
      const ty = Math.sin(angle) * distance;

      particle.style.setProperty("--tx", `${tx}px`);
      particle.style.setProperty("--ty", `${ty}px`);
      particle.style.left = "50%";
      particle.style.top = "50%";
      particle.style.animation = `confetti-burst 0.8s steps(6) forwards`;
      particle.style.animationDelay = `${i * 0.02}s`;

      container.appendChild(particle);
      setTimeout(() => particle.remove(), 1000);
    }
  }

  updateStreakCounter();

  (window as any).incrementStreak = function () {
    const today = getToday();
    const yesterday = getYesterday();
    const streak = getStreak();

    if (streak.lastDate === today) {
      return streak.count;
    } else if (streak.lastDate === yesterday) {
      streak.count++;
      streak.lastDate = today;
      saveStreak(streak);
      updateStreakCounter(true);
      return streak.count;
    } else {
      streak.count = 1;
      streak.lastDate = today;
      saveStreak(streak);
      updateStreakCounter(true);
      return streak.count;
    }
  };

  (window as any).updateStreakDisplay = updateStreakCounter;
</script>
