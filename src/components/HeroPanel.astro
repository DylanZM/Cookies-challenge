---
import Button from './Button.astro';
---
<div class="hero-text-area pixel-box">
  <h1 class="cursor-blink text-retro-highlight" style="font-size: 2rem; margin-bottom: 2rem;">
    SELECT YOUR<br/>CHALLENGE
  </h1>
  <p style="font-size: 0.8rem; line-height: 1.8; margin-bottom: 2rem; opacity: 0.9;">
    * ONE CHALLENGE PER DAY<br/>
    * ALWAYS A SURPRISE<br/>
    * 100% 8-BIT RETRO
  </p>

  <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
    <Button href="/cookies">
      ▶ PRESS START
    </Button>
    <Button href="/about" class="pixel-btn-outline">
      ? HOW TO PLAY
    </Button>
  </div>
</div>
