---
import PixelCookie from "./PixelCookie.astro";

interface Props {
  activePage?: string;
}
const { activePage = "" } = Astro.props;
---

<header class="retro-header pixel-box">
  <div class="header-inner">
    <a href="/" class="logo-link">
      <div class="logo-icon float-pixel">
        <PixelCookie scale={2} />
      </div>
      <div class="logo-text">
        <span class="text-retro-highlight">COOKIE</span><br />
        <span style="font-size: 0.6em; color: var(--cookie-edge);"
          >CHALLENGE</span
        >
      </div>
    </a>

    <nav class="retro-nav">
      <a
        href="/"
        class={`pixel-nav-link ${activePage === "home" ? "active" : ""}`}
      >
        [ HOME ]
      </a>
      <a
        href="/cookies"
        class={`pixel-nav-link ${activePage === "cookies" ? "active" : ""}`}
      >
        [ COOKIE ]
      </a>
      <a
        href="/about"
        class={`pixel-nav-link ${activePage === "about" ? "active" : ""}`}
      >
        [ INFO ]
      </a>
    </nav>
  </div>
</header>

<style>
  .retro-header {
    padding: 1rem 2rem;
    margin-bottom: 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  .logo-text {
    line-height: 1.2;
  }

  .retro-nav {
    display: flex;
    gap: 2rem;
  }
  .pixel-nav-link {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.1s;
  }
  .pixel-nav-link:hover {
    color: var(--ui-hover);
  }
  .pixel-nav-link:active {
    transform: translateY(2px);
  }
  .pixel-nav-link.active {
    color: var(--text-highlight);
    text-shadow: 2px 2px 0 var(--ui-shadow);
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-direction: column;
      gap: 1rem;
    }
    .retro-nav {
      gap: 1rem;
      font-size: 0.65rem;
    }
  }
</style>
