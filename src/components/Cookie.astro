---
---

<div id="cookie-container" class="relative w-80 h-80 cursor-pointer group perspective-1000 mx-auto">
  <!-- Glowing background effect -->
  <div class="absolute inset-0 bg-(--cookie-accent) rounded-full blur-3xl opacity-20 group-hover:opacity-40 transition-opacity duration-1000"></div>

  <!-- The Challenge Card that appears from behind -->
  <div id="challenge-card" class="absolute inset-0 m-auto w-72 h-48 bg-white/90 backdrop-blur-md rounded-2xl shadow-2xl flex flex-col items-center justify-center p-6 text-center transform scale-50 opacity-0 pointer-events-none transition-all duration-700 delay-300 z-0 border border-white/50">
    <h3 class="text-xl font-bold text-(--chocolate-chip) mb-2">Reto de Hoy</h3>
    <p id="challenge-text" class="text-lg text-(--cookie-text) font-medium leading-relaxed"></p>
    <div class="mt-4 text-sm text-(--cookie-edge) font-semibold uppercase tracking-widest">¡Vuelve mañana!</div>
  </div>

  <!-- Cookie Halves -->
  <div id="cookie-wrapper" class="absolute inset-0 w-full h-full rounded-full shadow-[0_20px_40px_-10px_rgba(0,0,0,0.3)] transition-transform duration-500 hover:scale-105 z-10 flex">
    
    <!-- Left Half -->
    <div class="cookie-half left w-1/2 h-full bg-(--cookie-dough) rounded-l-full relative overflow-hidden transition-all duration-1000">
      <div class="absolute inset-0 border-r-[3px] border-dashed border-(--cookie-edge)/30 right-0"></div>
      <div class="absolute inset-0 shadow-[inset_10px_0_30px_rgba(210,166,121,0.5)] rounded-l-full pointer-events-none"></div>
      
      <!-- Chocolate Chips Left -->
      <div class="chip absolute w-6 h-6 bg-(--chocolate-chip) rounded-full top-[20%] left-[30%] shadow-inner"></div>
      <div class="chip absolute w-8 h-8 bg-(--chocolate-chip) rounded-[40%] top-[60%] left-[40%] shadow-inner"></div>
      <div class="chip absolute w-5 h-5 bg-(--chocolate-chip) rounded-full top-[40%] left-[60%] shadow-inner"></div>
      <div class="chip absolute w-7 h-7 bg-(--chocolate-chip) rounded-[45%] top-[80%] left-[20%] shadow-inner"></div>
    </div>

    <!-- Right Half -->
    <div class="cookie-half right w-1/2 h-full bg-(--cookie-dough) rounded-r-full relative overflow-hidden transition-all duration-1000">
      <div class="absolute inset-0 shadow-[inset_-10px_0_30px_rgba(210,166,121,0.5)] rounded-r-full pointer-events-none"></div>
      
      <!-- Chocolate Chips Right -->
      <div class="chip absolute w-7 h-7 bg-(--chocolate-chip) rounded-full top-[15%] right-[40%] shadow-inner"></div>
      <div class="chip absolute w-6 h-6 bg-(--chocolate-chip) rounded-[40%] top-[50%] right-[30%] shadow-inner"></div>
      <div class="chip absolute w-5 h-5 bg-(--chocolate-chip) rounded-full top-[75%] right-[50%] shadow-inner"></div>
      <div class="chip absolute w-8 h-8 bg-(--chocolate-chip) rounded-[45%] top-[35%] right-[15%] shadow-inner"></div>
    </div>
  </div>

  <!-- Crumbs Particles (hidden initially) -->
  <div id="crumbs-container" class="absolute inset-0 pointer-events-none flex justify-center items-center z-20">
    <!-- Crumbs will be injected here via JS -->
  </div>

</div>

<style>
  /* Base styles for the cookie to add texture */
  .cookie-half {
    background-image: radial-gradient(circle, var(--cookie-dough) 40%, var(--cookie-edge) 100%);
  }
  .cookie-half::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  /* Opened state classes */
  .is-opened #cookie-wrapper {
    box-shadow: none;
    transform: scale(1) !important;
  }
  
  .is-opened .cookie-half.left {
    transform: translateX(-80%) rotate(-15deg);
    opacity: 0;
  }
  
  .is-opened .cookie-half.right {
    transform: translateX(80%) rotate(15deg);
    opacity: 0;
  }

  .is-opened #challenge-card {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
    z-index: 30;
  }

  /* Crumb Animation */
  @keyframes fallAndFade {
    0% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 1; }
    100% { transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(0); opacity: 0; }
  }

  .crumb {
    position: absolute;
    background-color: var(--cookie-edge);
    border-radius: 40%;
    animation: fallAndFade 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
</style>
