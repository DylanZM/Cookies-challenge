---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PixelCookie from "../components/PixelCookie.astro";
import StreakCounter from "../components/StreakCounter.astro";
import "../styles/global.css";
---

<Layout>
  <div class="retro-page">
    <Header activePage="cookies" />

    <main class="game-stage">
      <div class="stage-header pixel-box">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <h1
              class="text-retro-highlight"
              style="font-size: 1.2rem; margin-bottom: 0.5rem;"
            >
              &gt; DAILY QUEST ENCOUNTER
            </h1>
            <p id="status-msg" style="font-size: 0.7rem; opacity: 0.8;">
              CLICK THE COOKIE TO REVEAL YOUR CHALLENGE
            </p>
          </div>
          <StreakCounter />
        </div>
      </div>

      <!-- Gameplay Area -->
      <div
        class="interactive-area pixel-box"
        style="margin-top: 2rem; min-height: 400px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;"
        id="game-area"
      >
        <!-- Cookie Crumbs Container -->
        <div id="crumbs-container" style="position: absolute; inset: 0; pointer-events: none; z-index: 15;"></div>
        
        <!-- Unopened Cookie (Full) -->
        <div
          id="cookie-unopened"
          class="float-pixel"
          style="cursor: pointer; z-index: 10;"
        >
          <PixelCookie scale={10} />
        </div>

        <!-- Broken Cookie Halves (Hidden Initially) -->
        <div
          id="cookie-broken"
          style="display: none; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5;"
        >
          <div class="half-left">
            <PixelCookie scale={10} variant="left-half" />
          </div>
          <div class="half-right">
            <PixelCookie scale={10} variant="right-half" />
          </div>
        </div>

        <!-- Reward Card (Hidden Initially) -->
        <div
          id="challenge-card"
          class="pixel-box"
          style="display: none; position: absolute; z-index: 20; max-width: 400px; text-align: center; background: var(--ui-bg);"
        >
          <div
            class="text-retro-highlight blink-fast"
            style="font-size: 0.8rem; margin-bottom: 1rem;"
          >
            ⭐ NEW QUEST UNLOCKED ⭐
          </div>

          <p
            id="challenge-text"
            style="font-size: 1rem; line-height: 1.6; margin-bottom: 2rem; color: var(--text-primary);"
          >
          </p>

          <div
            style="font-size: 0.6rem; color: var(--cookie-light); margin-bottom: 1rem;"
          >
            DATE: <span id="challenge-date"></span>
          </div>

          <div
            style="display: inline-block; background: var(--ui-shadow); color: var(--text-highlight); padding: 8px 16px; font-size: 0.6rem;"
          >
            RETURN TOMORROW TO CONTINUE
          </div>
        </div>

        <!-- Hint if already completed today -->
        <div
          id="already-hint"
          style="display: none; position: absolute; bottom: -30px; font-size: 0.6rem; color: var(--cookie-light); width: 100%; text-align: center;"
        >
          [ QUEST COMPLETED TODAY. SAVING GAME... ]
        </div>
      </div>
    </main>

    <footer
      style="text-align: center; margin-top: 4rem; padding: 2rem; font-size: 0.6rem; opacity: 0.5;"
    >
      (C) 2024 COOKIE CHALLENGE SYSTEM
    </footer>
  </div>
</Layout>

<style>
  .retro-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
    min-height: 100vh;
  }

  .game-stage {
    margin-top: 2rem;
  }

  /* Break Animation classes */
  .anim-break .half-left {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: slideLeft 0.5s steps(4, end) forwards;
  }
  .anim-break .half-right {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: slideRight 0.5s steps(4, end) forwards;
  }

  @keyframes slideLeft {
    to {
      transform: translate(-150%, -50%);
      opacity: 0;
    }
  }
  @keyframes slideRight {
    to {
      transform: translate(50%, -50%);
      opacity: 0;
    }
  }

  .blink-fast {
    animation: blink 0.5s steps(2, end) infinite;
  }

  /* ── Cookie Crumb Particles ── */
  .cookie-crumb {
    position: absolute;
    pointer-events: none;
    z-index: 15;
    image-rendering: pixelated;
  }

  @keyframes crumb-burst-1 {
    0% {
      transform: translate(-50%, -50%) scale(1) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.3) rotate(360deg);
      opacity: 0;
    }
  }

  @keyframes crumb-burst-2 {
    0% {
      transform: translate(-50%, -50%) scale(1) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.5) rotate(-360deg);
      opacity: 0;
    }
  }

  @keyframes crumb-burst-3 {
    0% {
      transform: translate(-50%, -50%) scale(1.2) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.2) rotate(180deg);
      opacity: 0;
    }
  }
</style>

<script>
  const unopened = document.getElementById("cookie-unopened");
  const broken = document.getElementById("cookie-broken");
  const card = document.getElementById("challenge-card");
  const challengeTxt = document.getElementById("challenge-text");
  const dateTxt = document.getElementById("challenge-date");
  const statusMsg = document.getElementById("status-msg");
  const alreadyHint = document.getElementById("already-hint");

  if (!unopened || !broken || !card || !challengeTxt || !dateTxt)
    throw new Error("DOM Missing");

  // Load equipped cookie variant from localStorage
  const savedColorsStr = localStorage.getItem("cookie_variant");
  if (savedColorsStr) {
    try {
      const colors = JSON.parse(savedColorsStr);
      [unopened, broken].forEach((el) => {
        el.style.setProperty("--p-dough", colors.dough);
        el.style.setProperty("--p-chip", colors.chip);
        el.style.setProperty("--p-light", colors.light);
        el.style.setProperty("--p-dark", colors.dark);
        el.style.setProperty("--p-edge", colors.edge);
      });
    } catch (e) {
      console.error("Error loading cookie variant", e);
    }
  }

  const today = new Date().toISOString().split("T")[0];

  const formattedDate = new Date(today + "T12:00:00")
    .toLocaleDateString("en-US", {
      weekday: "short",
      day: "2-digit",
      month: "short",
    })
    .toUpperCase();

  function createCookieCrumbs() {
    const container = document.getElementById('crumbs-container');
    const unopenedRect = unopened!.getBoundingClientRect();
    const containerRect = container!.getBoundingClientRect();
    
    const centerX = unopenedRect.left + unopenedRect.width / 2 - containerRect.left;
    const centerY = unopenedRect.top + unopenedRect.height / 2 - containerRect.top;

    const crumbCount = 20;
    const colors = [
      'var(--p-dough)', 
      'var(--p-light)', 
      'var(--p-dark)',
      'var(--p-chip)'
    ];

    for (let i = 0; i < crumbCount; i++) {
      const crumb = document.createElement('div');
      crumb.className = 'cookie-crumb';
      
      const size = 8 + Math.random() * 16;
      crumb.style.width = `${size}px`;
      crumb.style.height = `${size}px`;
      crumb.style.background = colors[Math.floor(Math.random() * colors.length)];
      crumb.style.left = `${centerX}px`;
      crumb.style.top = `${centerY}px`;
      
      const angle = (Math.PI * 2 * i) / crumbCount;
      const distance = 100 + Math.random() * 150;
      const dx = Math.cos(angle) * distance;
      const dy = Math.sin(angle) * distance;
      
      crumb.style.setProperty('--dx', `${dx}px`);
      crumb.style.setProperty('--dy', `${dy}px`);
      
      const animations = ['crumb-burst-1', 'crumb-burst-2', 'crumb-burst-3'];
      const randomAnim = animations[Math.floor(Math.random() * animations.length)];
      crumb.style.animation = `${randomAnim} 1s steps(8, end) forwards`;
      crumb.style.animationDelay = `${i * 0.02}s`;
      
      // Add box-shadow for depth
      crumb.style.boxShadow = '2px 2px 0 rgba(0,0,0,0.3)';
      
      container!.appendChild(crumb);
      
      setTimeout(() => crumb.remove(), 1200);
    }
  }

  function showReward(challenge: string, isImmediate: boolean) {
    challengeTxt!.textContent = challenge;
    dateTxt!.textContent = formattedDate;

    if (isImmediate) {
      unopened!.style.display = "none";
      card!.style.display = "block";
    } else {
      // Create crumb particles
      createCookieCrumbs();
      
      // Animate break
      setTimeout(() => {
        unopened!.style.display = "none";
        broken!.style.display = "block";
        broken!.classList.add("anim-break");
      }, 100);

      setTimeout(() => {
        card!.style.display = "block";
      }, 700);
    }

    if (statusMsg) statusMsg.textContent = "QUEST DISCOVERED";
    if (alreadyHint) alreadyHint.style.display = "block";
    
    // Increment streak when quest is revealed
    if (typeof (window as any).incrementStreak === 'function') {
      (window as any).incrementStreak();
    }
  }

  const handleOpen = () => {
    unopened.removeEventListener("click", handleOpen);
    
    if (statusMsg) statusMsg.textContent = "[ CONTACTING AI ORACLE... ]";
    unopened.style.pointerEvents = 'none';
    unopened.style.opacity = '0.7';

    fetch('/api/challenge', { method: 'POST' })
      .then(res => res.json())
      .then(data => {
        showReward(data.challenge, false);
      })
      .catch(err => {
        console.error(err);
        showReward("Take 5 deep breaths (Server Error)", false);
      });
  };

  unopened.addEventListener("click", handleOpen);
</script>
