---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PixelCookie from '../components/PixelCookie.astro';
import '../styles/global.css';
---

<Layout>
<div class="retro-page">
  <Header activePage="cookies" />

  <main class="game-stage">
    
    <div class="stage-header pixel-box">
      <h1 class="text-retro-highlight" style="font-size: 1.2rem; margin-bottom: 0.5rem;">
        &gt; DAILY QUEST ENCOUNTER
      </h1>
      <p id="status-msg" style="font-size: 0.7rem; opacity: 0.8;">
        CLICK LA GALLETA PARA DESCUBRIR TU RETO
      </p>
    </div>

    <!-- Gameplay Area -->
    <div class="interactive-area pixel-box" style="margin-top: 2rem; min-height: 400px; display: flex; align-items: center; justify-content: center; position: relative;">
      
      <!-- Unopened Cookie (Full) -->
      <div id="cookie-unopened" class="float-pixel" style="cursor: pointer; z-index: 10;">
        <PixelCookie scale={10} />
      </div>

      <!-- Broken Cookie Halves (Hidden Initially) -->
      <div id="cookie-broken" style="display: none; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5;">
        <div class="half-left">
          <PixelCookie scale={10} variant="left-half" />
        </div>
        <div class="half-right">
          <PixelCookie scale={10} variant="right-half" />
        </div>
      </div>

      <!-- Reward Card (Hidden Initially) -->
      <div id="challenge-card" class="pixel-box" style="display: none; position: absolute; z-index: 20; max-width: 400px; text-align: center; background: var(--ui-bg);">
        <div class="text-retro-highlight blink-fast" style="font-size: 0.8rem; margin-bottom: 1rem;">
          ⭐ NUEVO RETO DESBLOQUEADO ⭐
        </div>
        
        <p id="challenge-text" style="font-size: 1rem; line-height: 1.6; margin-bottom: 2rem; color: var(--text-primary);"></p>
        
        <div style="font-size: 0.6rem; color: var(--cookie-light); margin-bottom: 1rem;">
          FECHA: <span id="challenge-date"></span>
        </div>

        <div style="display: inline-block; background: var(--ui-shadow); color: var(--text-highlight); padding: 8px 16px; font-size: 0.6rem;">
          VUELVE MAÑANA PARA CONTINUAR
        </div>
      </div>

      <!-- Hint if already completed today -->
      <div id="already-hint" style="display: none; position: absolute; bottom: -30px; font-size: 0.6rem; color: var(--cookie-light); width: 100%; text-align: center;">
        [ QUEST COMPLETADA HOY. GUARDANDO PARTIDA... ]
      </div>

    </div>

  </main>

  <footer style="text-align: center; margin-top: 4rem; padding: 2rem; font-size: 0.6rem; opacity: 0.5;">
    (C) 2024 COOKIE CHALLENGE SYSTEM
  </footer>
</div>
</Layout>

<style>
  .retro-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
    min-height: 100vh;
  }

  .game-stage {
    margin-top: 2rem;
  }

  /* Break Animation classes */
  .anim-break .half-left {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: slideLeft 0.5s steps(4, end) forwards;
  }
  .anim-break .half-right {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: slideRight 0.5s steps(4, end) forwards;
  }
  
  @keyframes slideLeft {
    to { transform: translate(-150%, -50%); opacity: 0; }
  }
  @keyframes slideRight {
    to { transform: translate(50%, -50%); opacity: 0; }
  }

  .blink-fast {
    animation: blink 0.5s steps(2, end) infinite;
  }
</style>

<script>
  import { getRandomChallenge } from '../data/challenges';

  const unopened     = document.getElementById('cookie-unopened');
  const broken       = document.getElementById('cookie-broken');
  const card         = document.getElementById('challenge-card');
  const challengeTxt = document.getElementById('challenge-text');
  const dateTxt      = document.getElementById('challenge-date');
  const statusMsg    = document.getElementById('status-msg');
  const alreadyHint  = document.getElementById('already-hint');

  if (!unopened || !broken || !card || !challengeTxt || !dateTxt) throw new Error('DOM Missing');

  // Load equipped cookie variant from localStorage
  const savedColorsStr = localStorage.getItem('cookie_variant');
  if (savedColorsStr) {
    try {
      const colors = JSON.parse(savedColorsStr);
      [unopened, broken].forEach(el => {
        el.style.setProperty('--p-dough', colors.dough);
        el.style.setProperty('--p-chip', colors.chip);
        el.style.setProperty('--p-light', colors.light);
        el.style.setProperty('--p-dark', colors.dark);
        el.style.setProperty('--p-edge', colors.edge);
      });
    } catch(e) { console.error('Error loading cookie variant', e); }
  }

  const today = new Date().toISOString().split('T')[0];
  const savedDate = localStorage.getItem('cookie_last_date');
  const savedChallenge = localStorage.getItem('cookie_current_challenge');

  const formattedDate = new Date(today + 'T12:00:00').toLocaleDateString('es-ES', {
    weekday: 'short', day: '2-digit', month: 'short'
  }).toUpperCase();

  function showReward(challenge: string, isImmediate: boolean) {
    challengeTxt!.textContent = challenge;
    dateTxt!.textContent = formattedDate;

    if (isImmediate) {
      unopened!.style.display = 'none';
      card!.style.display = 'block';
    } else {
      // Animate break
      unopened!.style.display = 'none';
      broken!.style.display = 'block';
      broken!.classList.add('anim-break');

      setTimeout(() => {
        card!.style.display = 'block';
      }, 600);
    }

    if (statusMsg) statusMsg.textContent = 'RETO DESCUBIERTO';
    if (alreadyHint) alreadyHint.style.display = 'block';
  }

  if (savedDate === today && savedChallenge) {
    showReward(savedChallenge, true);
  } else {
    const handleOpen = () => {
      unopened.removeEventListener('click', handleOpen);
      const challenge = getRandomChallenge();
      localStorage.setItem('cookie_last_date', today);
      localStorage.setItem('cookie_current_challenge', challenge);
      showReward(challenge, false);
    };

    unopened.addEventListener('click', handleOpen);
  }
</script>
