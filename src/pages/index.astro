---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PixelCookie from '../components/PixelCookie.astro';
import '../styles/global.css';

const cookieVariants = [
  { id: 'original', name: 'Classic', dough: '#d28c46', chip: '#3a1f0b', light: '#e6ab67', dark: '#b36b2b', edge: '#824715' },
  { id: 'macadamia', name: 'Macadamia', dough: '#e6ab67', chip: '#e6e6e6', light: '#f5cc99', dark: '#d28c46', edge: '#b36b2b' },
  { id: 'darkchoc', name: 'Dark Choc', dough: '#5c3a21', chip: '#1a0f05', light: '#7a4d2c', dark: '#3d2616', edge: '#29190e' },
  { id: 'avena', name: 'Oatmeal', dough: '#c29c76', chip: '#5c3a21', light: '#d6bba0', dark: '#a37c52', edge: '#7a5937' },
  { id: 'golden', name: 'Golden', dough: '#ffb84d', chip: '#d28c46', light: '#ffd699', dark: '#e69900', edge: '#b37700' },
];
---

<Layout>
<div class="retro-page">
  <Header activePage="home" />

  <!-- ════ HERO ════ -->
  <main class="hero-container">
    
    <div class="hero-text-area pixel-box">
      <h1 class="cursor-blink text-retro-highlight" style="font-size: 2rem; margin-bottom: 2rem;">
        SELECT YOUR<br/>CHALLENGE
      </h1>
      <p style="font-size: 0.8rem; line-height: 1.8; margin-bottom: 2rem; opacity: 0.9;">
        * UN RETO POR DÍA<br/>
        * SIEMPRE SORPRESA<br/>
        * 100% RETRO 8-BIT
      </p>
      
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/cookies" class="pixel-btn">
          ▶ PRESS START
        </a>
        <a href="/about" class="pixel-btn pixel-btn-outline">
          ? HOW TO PLAY
        </a>
      </div>
    </div>

    <!-- Right: Carousel -->
    <div class="hero-carousel pixel-box" style="text-align: center;">
      <h2 style="font-size: 1rem; margin-bottom: 2rem;" class="text-retro-highlight">
        COOKIE SELECTOR
      </h2>
      
      <div class="carousel-stage">
        <div class="carousel-track" id="pixel-track">
          {cookieVariants.map((v, i) => (
             <div class="c-slide" data-index={i} data-id={v.id} data-colors={JSON.stringify(v)}>
                <div class="cookie-render" style={`--p-dough: ${v.dough}; --p-chip: ${v.chip}; --p-light: ${v.light}; --p-dark: ${v.dark}; --p-edge: ${v.edge};`}>
                  <PixelCookie scale={6} />
                </div>
                <div class="cookie-name">{v.name}</div>
             </div>
          ))}
        </div>
        
        <button class="pixel-btn nav-btn prev" id="c-prev">◄</button>
        <button class="pixel-btn nav-btn next" id="c-next">►</button>
      </div>

      <div style="margin-top: 1.5rem;">
        <button id="select-btn" class="pixel-btn" style="width: 100%; max-width: 250px;">
          [ EQUIP COOKIE ]
        </button>
      </div>
      <div style="margin-top: 1rem; font-size: 0.6rem; color: var(--cookie-light);" id="equip-status">
        SELECT YOUR DAILY AVATAR
      </div>
    </div>

  </main>

  <footer style="text-align: center; margin-top: 4rem; padding: 2rem; font-size: 0.6rem; opacity: 0.5;">
    (C) 2024 COOKIE CHALLENGE SYSTEM
  </footer>
</div>
</Layout>

<style>
  .retro-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    min-height: 100vh;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (max-width: 800px) {
    .hero-container { grid-template-columns: 1fr; }
  }

  /* ── CSS Pixel Carousel ── */
  .carousel-stage {
    position: relative;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #221810;
    border: calc(var(--px) * 1) solid var(--ui-shadow);
    box-shadow: inset 0px 4px 0 0 rgba(0,0,0,0.5);
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .c-slide {
    position: absolute;
    transition: transform 0.4s steps(4, end), opacity 0.4s steps(4, end);
    text-align: center;
  }

  .cookie-render {
    animation: float-pixel 1.5s steps(2, end) infinite;
  }

  .cookie-name {
    margin-top: 1rem;
    font-size: 0.6rem;
    color: var(--text-highlight);
    background: var(--ui-shadow);
    padding: 4px;
    border: 2px solid var(--cookie-base);
  }

  /* Slide States (Center, Left, Right) */
  .c-slide[data-pos="0"] {
    transform: translateX(0) scale(1);
    opacity: 1;
    z-index: 10;
  }
  .c-slide[data-pos="1"] {
    transform: translateX(120px) scale(0.6);
    opacity: 0.5;
    z-index: 5;
  }
  .c-slide[data-pos="-1"] {
    transform: translateX(-120px) scale(0.6);
    opacity: 0.5;
    z-index: 5;
  }
  .c-slide[data-pos="hidden"] {
    transform: translateX(0) scale(0);
    opacity: 0;
    z-index: 1;
  }

  /* Carousel nav buttons */
  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.5rem;
    z-index: 20;
    font-size: 0.8rem;
  }
  .nav-btn.prev { left: 10px; }
  .nav-btn.next { right: 10px; }
  .nav-btn:active { transform: translateY(calc(var(--px) * 2 - 50%)); }

</style>

<script>
  const slides = document.querySelectorAll('.c-slide') as NodeListOf<HTMLElement>;
  const prevBtn = document.getElementById('c-prev');
  const nextBtn = document.getElementById('c-next');
  const selectBtn = document.getElementById('select-btn');
  const statusMsg = document.getElementById('equip-status');

  if (slides.length > 0 && prevBtn && nextBtn && selectBtn) {
    const N = slides.length;
    let current = 0;
    let autoPlay: number;

    function updateCarousel() {
      slides.forEach((slide, i) => {
        let diff = i - current;
        if (diff > Math.floor(N / 2))  diff -= N;
        if (diff < -Math.floor(N / 2)) diff += N;

        if (diff === 0) slide.dataset.pos = "0";
        else if (diff === 1) slide.dataset.pos = "1";
        else if (diff === -1) slide.dataset.pos = "-1";
        else slide.dataset.pos = "hidden";
      });
    }

    updateCarousel();

    function startAuto() {
      clearInterval(autoPlay);
      autoPlay = window.setInterval(() => {
        current = (current + 1) % N;
        updateCarousel();
      }, 3000);
    }
    startAuto();

    nextBtn.addEventListener('click', () => {
      current = (current + 1) % N;
      updateCarousel();
      startAuto();
    });
    
    prevBtn.addEventListener('click', () => {
      current = (current - 1 + N) % N;
      updateCarousel();
      startAuto();
    });

    selectBtn.addEventListener('click', () => {
      const activeSlide = Array.from(slides).find(s => s.dataset.pos === "0");
      if (activeSlide) {
        const colors = activeSlide.dataset.colors;
        if (colors) {
          localStorage.setItem('cookie_variant', colors);
          if (statusMsg) {
            statusMsg.textContent = "EQUIPPED! REDIRECTING...";
            statusMsg.style.color = "var(--text-highlight)";
          }
          setTimeout(() => {
            window.location.href = '/cookies';
          }, 800);
        }
      }
    });
  }
</script>
